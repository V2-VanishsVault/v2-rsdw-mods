{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "runtime.path": ["StorageMage/Scripts/?.lua", "?.lua"],
  "workspace.library": [],
  "workspace.ignoreDir": [".git"],
  "diagnostics.globals": [
    "RegisterHook", "RegisterKeyBind", "NotifyOnNewObject", "FindAllOf", "FindFirstOf", "StaticFindObject",
